<Window x:Class="LibraryManager.Windows.AuthorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление авторами" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="👤 Управление авторами" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#1F2937"
                   Margin="0,0,0,15"/>

        <!-- Таблица авторов -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            
            <DataGrid x:Name="AuthorsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      BorderThickness="0"
                      SelectionChanged="AuthorsDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Форма редактирования -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="8" 
                Padding="15"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Имя -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Имя:" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="FirstNameInput"/>
                </StackPanel>

                <!-- Фамилия -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Фамилия:" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="LastNameInput"/>
                </StackPanel>

                <!-- Дата рождения -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Дата рождения:" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <DatePicker x:Name="BirthDatePicker"/>
                </StackPanel>

                <!-- Страна -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Страна:" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="CountryInput"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="➕ Добавить" 
                    Click="Add_Click"
                    Style="{StaticResource PrimaryButton}"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button Content="💾 Сохранить" 
                    Click="Save_Click"
                    Style="{StaticResource PrimaryButton}"
                    Background="#059669"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button Content="🗑️ Удалить" 
                    Click="Delete_Click"
                    Style="{StaticResource DangerButton}"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button Content="Очистить" 
                    Click="Clear_Click"
                    Style="{StaticResource PrimaryButton}"
                    Background="#6B7280"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button Content="Закрыть" 
                    Click="Close_Click"
                    Style="{StaticResource PrimaryButton}"
                    Background="#374151"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
