<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" fx:controller="ru.mirea.project.controller.StatusFormController" spacing="16" prefWidth="480" styleClass="form">
 <Label text="Смена статуса" styleClass="section-title"/><Label fx:id="currentLabel"/>
 <Label text="В списке доступны только разрешённые переходы." wrapText="true" styleClass="muted"/>
 <VBox spacing="6"><Label text="Новый статус"/><ComboBox fx:id="nextStatus" maxWidth="Infinity"/></VBox>
 <Label fx:id="error" minHeight="38" wrapText="true" maxWidth="Infinity" styleClass="error-text"/>
 <HBox alignment="CENTER_RIGHT" spacing="10"><Button text="Отмена" onAction="#cancel" cancelButton="true"/><Button text="Сохранить" onAction="#save" defaultButton="true" styleClass="primary"/></HBox>
</VBox>
